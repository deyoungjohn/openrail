# Indexer process environment: names only, no values.
# Install as /etc/openrail/indexer.env mode 0600 root:root.

NEAR_ENV=
NEAR_ROOT_ACCOUNT=
NEAR_RPC_URL=
NEAR_RPC_URL_FALLBACK=
# Calls to the first (paid) URL per UTC day; keep the services together under 21,400/day.
NEAR_RPC_DAILY_BUDGET=2000

INDEXER_DB_PATH=
NEARBLOCKS_API_URL=
NEARBLOCKS_API_KEY=
NEARBLOCKS_API_KEY_2=
NEARBLOCKS_API_KEY_3=
INDEXER_PORT=
ONECLICK_API_URL=
ONECLICK_JWT=
EVM_RPC_URL=
INDEXER_POLL_INTERVAL_MS=
INDEXER_MAX_PAGES=
# Optional comma-separated single-writer SQLite event files (watcher, payout worker); read-only.
INDEXER_EVENT_SOURCES=/var/lib/openrail/watcher.sqlite,/var/lib/openrail/payout.sqlite
# ISO time or "now": ignore everything older; existing rows stay. The v3 walk stops here.
INDEXER_FROM=
