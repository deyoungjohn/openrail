# API process environment: names only, no values.
# Install as /etc/openrail/api.env mode 0600 root:root.

NEAR_ENV=
NEAR_ROOT_ACCOUNT=
NEAR_RPC_URL=
NEAR_RPC_URL_FALLBACK=

# REL-2: 1 after the contract supports labelled claim accounts.
CLAIM_LABELS=
# 1 turns on the confidential balance and shield cash-out routes.
CONFIDENTIAL_INTENTS=
# Largest withdraw per call in settlement base units (default 10,000 USDC).
CONFIDENTIAL_WITHDRAW_MAX=

API_PORT=
API_RECIPIENT=
PAY_BASE_URL=
WEB_ORIGIN=
COOKIE_DOMAIN=
DATABASE_URL=

ISSUER_URL=
ISSUER_SERVICE_KEY=

ONECLICK_API_URL=
ONECLICK_JWT=

STORAGE_CREDIT_BALANCE=
STORAGE_CREDIT_AMOUNT=
INDEXER_URL=
# SECRET: shared with the payout worker for the module's internal settings read.
PAYOUT_INTERNAL_KEY=

# Extra the payer is asked to send, in basis points (default 10 = 0.1 %). The provider's fee comes out of what is sent;
# without it a payment from Solana arrived 0.0095 % short and left the order "partially paid".
QUOTE_MARGIN_BPS=10
