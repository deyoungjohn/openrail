# Issuer process environment: names only, no values.
# Install as /etc/openrail/issuer.env mode 0600 root:root.

NEAR_ENV=
INDEXER_URL=
NEAR_ROOT_ACCOUNT=
NEAR_RPC_URL=
NEAR_RPC_URL_FALLBACK=
# Calls to the first (paid) URL per UTC day; keep the services together under 21,400/day.
NEAR_RPC_DAILY_BUDGET=2000

# REL-2: 1 after the contract supports labelled claim accounts.
CLAIM_LABELS=

ISSUER_ACCOUNT_ID=
ISSUER_PRIVATE_KEY=
RELAY_PRIVATE_KEY=
ISSUER_SERVICE_KEY=
ISSUER_PORT=
ISSUER_ACCOUNT_WAIT_MS=
ISSUER_ACCOUNT_POLL_MS=
