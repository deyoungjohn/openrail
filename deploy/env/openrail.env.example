# Combined environment for every service. Copy to a file OUTSIDE the repository, chmod 600, fill the
# lines marked SECRET, then run: sudo deploy/split-env.sh <that file>
# split-env.sh gives each service only the names in its own deploy/env/<service>.env.example.
# Public values are filled in; edit them if your hosts or accounts differ.

# --- shared / chain ---
NEAR_ENV=mainnet
NEAR_ROOT_ACCOUNT=openrail.near
NEAR_RPC_URL=https://rpc.mainnet.near.org
# A second RPC provider for failover (recommended; the free public node rate-limits). Leave empty to skip.
NEAR_RPC_URL_FALLBACK=

# --- api (internet-facing; holds no NEAR key) ---
API_PORT=3001
PAY_BASE_URL=https://openrail.incepture.dev
WEB_ORIGIN=https://openrail.incepture.dev
COOKIE_DOMAIN=openrail.incepture.dev
DATABASE_URL=/var/lib/openrail/api.sqlite
ISSUER_URL=http://127.0.0.1:8787
INDEXER_URL=http://127.0.0.1:8788
# SECRET: a long random string you invent (openssl rand -hex 32). The SAME value goes to the api and the issuer.
ISSUER_SERVICE_KEY=
# 1Click quote API. SECRET: your 1Click JWT. Also used by the indexer to enrich receipts.
ONECLICK_API_URL=https://1click.chaindefuser.com
ONECLICK_JWT=
# Storage credit the api offers new issuers (yoctoNEAR). Leave as is unless you changed the policy.
STORAGE_CREDIT_BALANCE=0
STORAGE_CREDIT_AMOUNT=1000000000000000000000000

# --- issuer (holds the issue_for/log_quote key and the acknowledge_evm relay key) ---
ISSUER_ACCOUNT_ID=issuer.openrail.near
ISSUER_PORT=8787
# SECRET: private key of the key that may call issue_for and log_quote (keyring item issuer-fc-key).
ISSUER_PRIVATE_KEY=
# SECRET: private key of the key that may call acknowledge_evm (keyring item relayer-fc-key).
RELAY_PRIVATE_KEY=

# --- watcher (reconcile, retry_distribution, clear_stale_lock) ---
WATCHER_ACCOUNT_ID=watcher.openrail.near
# SECRET: private key of the watcher key (keyring item watcher-fc-key).
WATCHER_PRIVATE_KEY=
WATCHER_HEALTH_PORT=8080
WATCHER_MIN_BALANCE_NEAR=0.5
# Where alerts go (a Slack/Discord/ntfy webhook). Leave empty to log only.
ALERT_WEBHOOK_URL=

# --- indexer ---
INDEXER_PORT=8788
INDEXER_DB_PATH=/var/lib/openrail/indexer.sqlite
# NearBlocks free plan: 10 calls/minute, 420 calls/day, 12,500/month. One quiet poll is one call, so the
# 15 s default would spend the day's quota in under two hours. 300000 ms (5 min) is about 288 calls/day.
INDEXER_POLL_INTERVAL_MS=300000
INDEXER_MAX_PAGES=2
NEARBLOCKS_API_URL=https://api.nearblocks.io
# SECRET: NearBlocks API key (the indexer falls back to RPC without it, but is slower).
NEARBLOCKS_API_KEY=

# --- web (public build values; baked at build time by deploy/build.sh, not read from here) ---
NEXT_PUBLIC_API_MODE=live
NEXT_PUBLIC_API_URL=https://api.openrail.incepture.dev
NEXT_PUBLIC_NEAR_NETWORK=mainnet
NEXT_PUBLIC_ROOT_CONTRACT=openrail.near
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_API_PUBLISHABLE_KEY=
