# Watcher process environment: names only, no values.
# Install as /etc/openrail/watcher.env mode 0600 root:root.

NEAR_ENV=
INDEXER_URL=
NEAR_ROOT_ACCOUNT=
NEAR_RPC_URL=
NEAR_RPC_URL_FALLBACK=
# Calls to the first (paid) URL per UTC day; keep the services together under 21,400/day.
NEAR_RPC_DAILY_BUDGET=2000

WATCHER_DB_PATH=/var/lib/openrail/watcher.sqlite
WATCHER_ACCOUNT_ID=
WATCHER_PRIVATE_KEY=
# triggered (default): no timer reads; the API pokes when the provider sees money, plus a sweep at start and daily.
# poll: the old cadence ladder.
WATCHER_MODE=
# Sweep of every open claim in trigger mode (ms, default one day); "off" turns it off.
WATCHER_SWEEP_INTERVAL_MS=
# How long a poked claim's balance is read at the fast cadence (ms, default 3 minutes).
WATCHER_ARM_WINDOW_MS=
WATCHER_POLL_INTERVAL_MS=
WATCHER_SLOW_INTERVAL_MS=
WATCHER_QUOTE_TTL_MS=
WATCHER_MIN_BALANCE_NEAR=
WATCHER_HEALTH_PORT=
WATCHER_EXTRA_CLAIMS=
ALERT_WEBHOOK_URL=
