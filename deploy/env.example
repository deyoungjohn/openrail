# Openrail server environment template: names only, no values.
# Install as /etc/openrail/env with mode 0640 root:openrail. Never commit values.

# --- shared / NEAR ---
NEAR_ENV=
NEAR_ROOT_ACCOUNT=
NEAR_RPC_URL=
NEAR_RPC_URL_FALLBACK=
FEE_ACCOUNT=
VAULT_GLOBAL_HASH=

# --- web (build-time public values; rebuild when changed) ---
NEXT_PUBLIC_API_MODE=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_NEAR_NETWORK=
NEXT_PUBLIC_ROOT_CONTRACT=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_API_PUBLISHABLE_KEY=

# --- api ---
API_PORT=
API_RECIPIENT=
PAY_BASE_URL=
WEB_ORIGIN=
COOKIE_DOMAIN=
DATABASE_URL=
ISSUER_URL=
ISSUER_SERVICE_KEY=
STORAGE_CREDIT_BALANCE=
STORAGE_CREDIT_AMOUNT=

# --- 1Click / quote client ---
ONECLICK_API_URL=
ONECLICK_JWT=

# --- issuer ---
ISSUER_ACCOUNT_ID=
ISSUER_PRIVATE_KEY=
RELAY_PRIVATE_KEY=
ISSUER_PORT=
ISSUER_ACCOUNT_WAIT_MS=
ISSUER_ACCOUNT_POLL_MS=

# --- watcher ---
WATCHER_ACCOUNT_ID=
WATCHER_PRIVATE_KEY=
WATCHER_POLL_INTERVAL_MS=
WATCHER_SLOW_INTERVAL_MS=
WATCHER_QUOTE_TTL_MS=
WATCHER_MIN_BALANCE_NEAR=
WATCHER_HEALTH_PORT=
WATCHER_EXTRA_CLAIMS=
ALERT_WEBHOOK_URL=

# --- indexer ---
INDEXER_DB_PATH=
NEARBLOCKS_API_URL=
NEARBLOCKS_API_KEY=

# --- mainnet guards (human-run tools only) ---
OWED_CONFIRM_MAINNET=
MAX_SPEND_USD=
DRY_RUN=
