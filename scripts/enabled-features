#!/usr/bin/env bash
# Prints the enabled module ids from openrail.modules.json, comma-separated (empty if none).
# With --all prints every enabled id (one per line) for CI loops.
set -euo pipefail
cd "$(dirname "$0")/.."
node -e '
const m = JSON.parse(require("fs").readFileSync("openrail.modules.json", "utf8")).modules.filter((x) => x.enabled);
if (process.argv[1] === "--all") console.log(m.map((x) => x.id).join("\n"));
else console.log(m.map((x) => x.id).join(","));
' -- "${1:-}"
