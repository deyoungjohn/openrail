{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NftMintEvent",
  "type": "object",
  "required": [
    "standard",
    "version",
    "event",
    "data"
  ],
  "properties": {
    "standard": {
      "type": "string",
      "const": "nep171"
    },
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "event": {
      "type": "string",
      "const": "nft_mint"
    },
    "data": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "owner_id",
          "token_ids"
        ],
        "properties": {
          "owner_id": {
            "type": "string"
          },
          "token_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "memo": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}