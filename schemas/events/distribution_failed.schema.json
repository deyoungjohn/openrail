{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DistributionFailedEvent",
  "type": "object",
  "required": [
    "standard",
    "version",
    "event",
    "data"
  ],
  "properties": {
    "standard": {
      "type": "string",
      "const": "openrail"
    },
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "event": {
      "type": "string",
      "const": "distribution_failed"
    },
    "data": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "token_id",
          "leg"
        ],
        "properties": {
          "token_id": {
            "type": "string"
          },
          "leg": {
            "type": "object"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}