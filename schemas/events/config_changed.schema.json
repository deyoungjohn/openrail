{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConfigChangedEvent",
  "type": "object",
  "required": [
    "standard",
    "version",
    "event",
    "data"
  ],
  "properties": {
    "standard": {
      "type": "string",
      "const": "openrail"
    },
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "event": {
      "type": "string",
      "const": "config_changed"
    },
    "data": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "parameter",
          "new_value"
        ],
        "properties": {
          "parameter": {
            "type": "string"
          },
          "new_value": {
            "type": "string"
          }
        }
      }
    }
  }
}