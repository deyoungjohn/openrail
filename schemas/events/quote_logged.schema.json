{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QuoteLoggedEvent",
  "type": "object",
  "required": [
    "standard",
    "version",
    "event",
    "data"
  ],
  "properties": {
    "standard": {
      "type": "string",
      "const": "openrail"
    },
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "event": {
      "type": "string",
      "const": "quote_logged"
    },
    "data": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "token_id",
          "quote_id",
          "deposit_address",
          "deadline_requested",
          "refund_to",
          "route_id"
        ],
        "properties": {
          "token_id": {
            "type": "string"
          },
          "quote_id": {
            "type": "string"
          },
          "deposit_address": {
            "type": "string"
          },
          "deadline_requested": {
            "type": "integer",
            "minimum": 0
          },
          "refund_to": {
            "type": "string"
          },
          "route_id": {
            "type": "string"
          }
        }
      }
    }
  }
}