{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IssueEvent",
  "type": "object",
  "required": [
    "standard",
    "version",
    "event",
    "data"
  ],
  "properties": {
    "standard": {
      "type": "string",
      "const": "openrail"
    },
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "event": {
      "type": "string",
      "const": "issue"
    },
    "data": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "token_id",
          "kind",
          "issuer_id",
          "owner_id",
          "terms_hash",
          "amount_due",
          "due_date"
        ],
        "properties": {
          "token_id": {
            "type": "string"
          },
          "kind": {
            "type": "integer",
            "minimum": 0
          },
          "issuer_id": {
            "type": "string"
          },
          "owner_id": {
            "type": "string"
          },
          "debtor": {
            "type": [
              "object",
              "null"
            ]
          },
          "terms_hash": {
            "type": "string"
          },
          "amount_due": {
            "type": "string"
          },
          "due_date": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}