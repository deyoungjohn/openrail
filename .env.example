# Names only, no values. Copy to .env (git-ignored) and fill in locally; never commit values.
# Secrets are read from the environment only, through the env helper.

# --- shared / chain ---
NEAR_ENV=
NEAR_ROOT_ACCOUNT=
NEAR_RPC_URL=
NEAR_RPC_URL_FALLBACK=
FEE_ACCOUNT=
VAULT_GLOBAL_HASH=

# --- mainnet run guards (human-run scripts only) ---
OWED_CONFIRM_MAINNET=
MAX_SPEND_USD=
DRY_RUN=

# --- api ---
API_PORT=
API_BASE_URL=
API_RECIPIENT=
PAY_BASE_URL=
WEB_ORIGIN=
COOKIE_DOMAIN=
ONECLICK_JWT=
ONECLICK_API_URL=
DATABASE_URL=
INDEXER_URL=
ISSUER_URL=
ISSUER_SERVICE_KEY=
STORAGE_CREDIT_BALANCE=
STORAGE_CREDIT_AMOUNT=

# --- issuer (function-call key on the root account: issue_for, log_quote) ---
ISSUER_ACCOUNT_ID=
ISSUER_PRIVATE_KEY=

# --- watcher (function-call key: reconcile, retry_distribution, clear_stale_lock) ---
WATCHER_ACCOUNT_ID=
WATCHER_PRIVATE_KEY=
WATCHER_POLL_INTERVAL_MS=
WATCHER_MIN_BALANCE_NEAR=
ALERT_WEBHOOK_URL=

# --- indexer ---
INDEXER_DB_PATH=
INDEXER_SOURCE=
INDEXER_PORT=
INDEXER_POLL_INTERVAL_MS=
INDEXER_MAX_PAGES=
NEARBLOCKS_API_URL=
NEARBLOCKS_API_KEY=
NEARBLOCKS_DAILY_BUDGET=

# --- relayer (origin-chain gas keys, only if a module needs them) ---
RELAYER_ACCOUNT_ID=
RELAYER_PRIVATE_KEY=
EVM_RPC_URL=

# --- web ---
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_NEAR_NETWORK=
NEXT_PUBLIC_ROOT_ACCOUNT=

# --- cli ---
OPENRAIL_API_KEY=
OPENRAIL_API_URL=
