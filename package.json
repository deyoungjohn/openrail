{
  "name": "openrail",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "gen:ack-vectors": "tsx scripts/gen-ack-vectors.ts",
    "gen:modules": "tsx scripts/gen-modules.ts",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "pnpm -r test",
    "t2:g1": "tsx scripts/t2/g1.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "viem": "2.57.14",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@openrail/shared": "workspace:*"
  }
}
